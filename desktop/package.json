{
  "name": "nion-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-first Nion application shell with bundled local helper runtime",
  "author": "zhangtiancheng",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:main": "tsc -p tsconfig.json --watch",
    "dev:electron": "pnpm exec electron dist/main/index.js",
    "dev": "node dist/main/index.js",
    "test": "node --test tests/*.test.mjs",
    "package:builder": "../scripts/package-desktop.sh builder",
    "package:forge": "../scripts/package-desktop.sh forge",
    "build:helper": "../scripts/build-python-helper.sh"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "katex": "^0.16.41"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.2",
    "typescript": "^5.8.2",
    "vite": "^7.1.3",
    "yaml": "^2.8.1"
  }
}
